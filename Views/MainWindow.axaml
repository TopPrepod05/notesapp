<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NotesApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="NotesApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="NotesApp">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="* 2*" ShowGridLines="True">

        <StackPanel Grid.Column="0">
            <ListBox ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <Grid Grid.Column="1" 
              RowDefinitions=".75* 3* *" ShowGridLines="True">
            <TextBox Margin="10" 
                     VerticalContentAlignment="Center" 
                     PlaceholderText="Заголовок:"
                     FontSize="24"
                     FontWeight="SemiBold"/>
            <TextBox Margin="10"
                     Grid.Row="1"
                     PlaceholderText="Контент:"
                     FontSize="20"
                     AcceptsReturn="True"
                     AcceptsTab="True"/>

            <StackPanel Margin="10" 
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Grid.Row="2">
                
                <Button Content="Добавить" Margin="0 0 10 0" />
                <Button Content="Удалить" />

            </StackPanel>


        </Grid>
    </Grid>
    

</Window>
