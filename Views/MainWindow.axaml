<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NotesApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="NotesApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="NotesApp">
    <!--
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>
    -->

    <Grid ColumnDefinitions="* 2*" ShowGridLines="True">

            <ScrollViewer Grid.Column="0">
                <StackPanel>
                    <ListBox ItemsSource="{Binding Notes}" 
                                SelectedItem="{Binding SelectedNote}"
                                SelectionMode="Toggle">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" 
                                                FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='Изменено: {0}'}" 
                                                FontWeight="Light"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>

        <Grid Grid.Column="1" 
              RowDefinitions=".75* 3* *" ShowGridLines="True">
            <TextBox Margin="10" 
                     VerticalContentAlignment="Center" 
                     PlaceholderText="Заголовок:"
                     FontSize="24"
                     FontWeight="SemiBold"
                     Text="{Binding Title}"/>
            <TextBox Margin="10"
                     Grid.Row="1"
                     PlaceholderText="Контент:"
                     FontSize="20"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     Text="{Binding Content}"/>

            <StackPanel Margin="10" 
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Grid.Row="2">
                
                <Button Command="{Binding AddNoteCommand}" Content="Добавить" Margin="0 0 10 0" />
                <Button Command="{Binding DeleteNoteCommand}" Content="Удалить" />

            </StackPanel>


        </Grid>
    </Grid>
    

</Window>
